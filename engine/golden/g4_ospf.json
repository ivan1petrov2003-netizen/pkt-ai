{
  "meta": {"name": "G4: OSPF, цепочка из 3 роутеров"},
  "devices": [
    {"name": "R1", "template": "Router0", "x": 200, "y": 200,
     "config": ["hostname R1",
                "interface GigabitEthernet0/0",
                " ip address 10.0.12.1 255.255.255.252",
                " no shutdown",
                "interface GigabitEthernet0/1",
                " ip address 10.1.1.1 255.255.255.0",
                " no shutdown",
                "router ospf 1",
                " network 10.0.12.0 0.0.0.3 area 0",
                " network 10.1.1.0 0.0.0.255 area 0"]},
    {"name": "R2", "template": "Router0", "x": 500, "y": 200,
     "config": ["hostname R2",
                "interface GigabitEthernet0/0",
                " ip address 10.0.12.2 255.255.255.252",
                " no shutdown",
                "interface GigabitEthernet0/1",
                " ip address 10.0.23.2 255.255.255.252",
                " no shutdown",
                "router ospf 1",
                " network 10.0.12.0 0.0.0.3 area 0",
                " network 10.0.23.0 0.0.0.3 area 0"]},
    {"name": "R3", "template": "Router0", "x": 800, "y": 200,
     "config": ["hostname R3",
                "interface GigabitEthernet0/0",
                " ip address 10.0.23.1 255.255.255.252",
                " no shutdown",
                "interface GigabitEthernet0/1",
                " ip address 10.3.3.1 255.255.255.0",
                " no shutdown",
                "router ospf 1",
                " network 10.0.23.0 0.0.0.3 area 0",
                " network 10.3.3.0 0.0.0.255 area 0"]},
    {"name": "PC1", "template": "PC0", "x": 120, "y": 380,
     "ip": "10.1.1.10", "mask": "255.255.255.0", "gateway": "10.1.1.1"},
    {"name": "PC3", "template": "PC0", "x": 880, "y": 380,
     "ip": "10.3.3.10", "mask": "255.255.255.0", "gateway": "10.3.3.1"}
  ],
  "links": [
    {"from": "R1", "from_port": "GigabitEthernet0/0", "to": "R2", "to_port": "GigabitEthernet0/0", "cable": "eCrossOver"},
    {"from": "R2", "from_port": "GigabitEthernet0/1", "to": "R3", "to_port": "GigabitEthernet0/0", "cable": "eCrossOver"},
    {"from": "R1", "from_port": "GigabitEthernet0/1", "to": "PC1", "to_port": "FastEthernet0"},
    {"from": "R3", "from_port": "GigabitEthernet0/1", "to": "PC3", "to_port": "FastEthernet0"}
  ]
}
